# ===== ENVIRONMENT VARIABLES =====

# MongoDB Connection String
# Choose ONE of these options:

# Option 1: LOCAL MongoDB (on your computer)
# Uncomment if you have MongoDB running locally on port 27017
# MONGODB_URI=mongodb://localhost:27017/echopod

# Option 2: MONGODB ATLAS (Cloud - FREE)
# 1. Go to https://www.mongodb.com/cloud/atlas
# 2. Create free account and cluster
# 3. Get connection string
# 4. Replace with your actual string below:
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/echopod?retryWrites=true&w=majority

# EXAMPLE (replace with your actual atlas connection string):
MONGODB_URI=mongodb+srv://demo:demo123@cluster0.abcde.mongodb.net/echopod?retryWrites=true&w=majority

# JWT Secret (optional - already has default)
# JWT_SECRET=your-secret-key-here

# Next.js Environment
NODE_ENV=development
